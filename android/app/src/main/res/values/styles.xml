<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.MisSchoolApp.Button.Base" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MisSchoolApp.Button.Secondary" parent="Widget.MisSchoolApp.Button.Base">
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="strokeColor">@color/button_secondary_stroke</item>
    </style>

    <style name="Widget.MisSchoolApp.Button.HeroAction" parent="Widget.MisSchoolApp.Button.Base">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/brand_navy</item>
        <item name="strokeColor">@color/white</item>
    </style>

    <style name="Widget.MisSchoolApp.Button.Start" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">@color/button_start</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MisSchoolApp.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MisSchoolApp.Button.DateNavigation" parent="Widget.MisSchoolApp.Button.Primary">
        <item name="android:backgroundTint">@color/brand_blue_soft</item>
        <item name="android:textColor">@color/text_accent</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.MisSchoolApp.Button.Today" parent="Widget.MisSchoolApp.Button.DateNavigation">
        <item name="android:backgroundTint">@color/brand_yellow_soft</item>
        <item name="android:textColor">@color/brand_yellow_text</item>
    </style>

</resources>
