<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/timetable_row_spacing"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="@dimen/timetable_card_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider_soft"
        app:strokeWidth="@dimen/timetable_card_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/timetable_row_padding_horizontal"
            android:paddingTop="@dimen/timetable_row_padding_vertical"
            android:paddingEnd="@dimen/timetable_row_padding_horizontal"
            android:paddingBottom="@dimen/timetable_row_padding_vertical">

            <TextView
                android:id="@+id/dateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/timetable_row_spacing"
                android:lineSpacingExtra="0dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
