<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_page"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/setupFormGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_hero_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/setup_description"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/setup_school_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/schoolQueryInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/brand_blue"
                android:hint="@string/setup_school_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingVertical="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Button
                android:id="@+id/searchSchoolButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/brand_blue"
                android:paddingVertical="12dp"
                android:text="@string/setup_school_search_button"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_school_helper"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_metadata" />

            <TextView
                android:id="@+id/schoolSearchMessageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/brand_blue_soft"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_metadata"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/setup_school_selected_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedSchoolSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/surface_card"
                android:padding="14dp"
                android:text="@string/setup_school_selected_empty"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small" />

            <TextView
                android:id="@+id/schoolResultsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/setup_school_results_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/schoolResultsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/setup_grade_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/gradeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/brand_blue"
                android:hint="@string/setup_grade_hint"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="1"
                android:paddingVertical="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/setup_class_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/classInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/brand_blue"
                android:hint="@string/setup_class_hint"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="2"
                android:paddingVertical="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Button
                android:id="@+id/saveStudentInfoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/brand_blue"
                android:paddingVertical="14dp"
                android:text="@string/setup_save_button"
                android:textColor="@color/white"
                android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/telemetryConsentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_consent_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_page_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_telemetry_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Switch
                    android:id="@+id/setupAnalyticsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="@string/settings_analytics_consent"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/setupDiagnosticsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_diagnostics_consent"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/completeTelemetryConsentButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/brand_blue"
                    android:paddingVertical="14dp"
                    android:text="@string/setup_consent_continue"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
</layout>
