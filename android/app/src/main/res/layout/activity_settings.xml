<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

<data />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/settings_back"
                android:padding="8dp"
                android:src="@drawable/ic_back_simple" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_page_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_description"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_profile_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_profile_selector_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/settingsProfileSelector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_blue"
            android:popupBackground="@drawable/bg_profile_selector_popup" />

        <Button
            android:id="@+id/addProfileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_blue_soft"
            android:text="@string/settings_profile_add"
            android:textColor="@color/brand_blue"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_profile_name_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsProfileNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="@string/setup_profile_name_hint"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"
            android:maxLength="10"
            android:maxLines="1"
            android:paddingVertical="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/setup_school_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsSchoolQueryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="@string/setup_school_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingVertical="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/searchSchoolButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/brand_blue"
            android:paddingVertical="12dp"
            android:text="@string/setup_school_search_button"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_school_helper"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_metadata" />

        <TextView
            android:id="@+id/schoolSearchMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/brand_blue_soft"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_metadata"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_school_selected_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedSchoolSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface_card"
            android:padding="14dp"
            android:text="@string/setup_school_selected_empty"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/schoolResultsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_school_results_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/schoolResultsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/setup_grade_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsGradeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="@string/setup_grade_hint"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLength="1"
            android:paddingVertical="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/setup_class_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsClassInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="@string/setup_class_hint"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="2"
            android:paddingVertical="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/deleteProfileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@android:color/transparent"
            android:text="@string/settings_profile_delete"
            android:textColor="@color/error_red"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/settings_timer_display_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/timerDisplayCountRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_timer_display_count"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/timerDisplayRingRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_timer_display_ring"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/settings_timer_alert_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_timer_alert_description"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/settings_telemetry_title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_telemetry_description"
            android:textColor="@color/text_primary" />
        <Switch
            android:id="@+id/analyticsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/settings_analytics_consent"
            android:textColor="@color/text_primary" />
        <Switch
            android:id="@+id/diagnosticsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/settings_diagnostics_consent"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/brand_blue"
            android:paddingVertical="14dp"
            android:text="@string/settings_save_button"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small" />

    </LinearLayout>

</ScrollView>

</layout>
